# Optional: FFmpeg path (default uses system PATH)
FFMPEG_PATH=

# Job cleanup TTL in minutes (default 60)
JOB_TTL_MINUTES=60

# Max concurrent jobs (default 2)
MAX_CONCURRENT_JOBS=2

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://mymevert.id,https://mymevert-id.vercel.app