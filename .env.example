# Optional: FFmpeg path (default uses system PATH)
FFMPEG_PATH=

# Job cleanup TTL in minutes (default 30)
JOB_TTL_MINUTES=30

# Max concurrent jobs (default 1)
MAX_CONCURRENT_JOBS=1

# Conversion command timeout in seconds (default 900 = 15 menit)
CONVERSION_TIMEOUT=900

# Max upload size in MB for local file conversion (default 100)
MAX_UPLOAD_SIZE_MB=100

# Audio bitrate for MP3 conversion in kbps (default 192)
AUDIO_BITRATE_KBPS=192

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://mymevert.id,https://mymevert-id.vercel.app
