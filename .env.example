# FFmpeg path (optional, defaults to system PATH)
FFMPEG_PATH=

# Cookies for yt-dlp (recommended for Docker/Railway)
# COOKIES_FILE=cookies.txt  # path to cookies.txt file in container
# COOKIES_BROWSER=chrome  # not recommended for Docker (no browser in container)

# Job cleanup TTL in minutes (optional, default 60)
JOB_TTL_MINUTES=60

# Frontend origins allowed for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://mymevert.id,https://mymevert-id.vercel.app